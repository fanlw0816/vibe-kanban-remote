# Vibe Kanban Remote Server Configuration
# Copy this file to .env and configure required variables

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# JWT Secret - Base64 encoded, at least 32 bytes decoded
# Generate with: openssl rand -base64 32
VIBEKANBAN_REMOTE_JWT_SECRET=

# Public URL where the server will be accessible
# Example: https://kanban.example.com
PUBLIC_BASE_URL=http://localhost:8081

# ===========================================
# AUTHENTICATION (configure at least one)
# ===========================================

# Option 1: Self-hosted local auth (simple username/password)
SELF_HOST_LOCAL_AUTH_EMAIL=admin@example.com
SELF_HOST_LOCAL_AUTH_PASSWORD=your-secure-password

# Option 2: GitHub OAuth
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Option 3: Google OAuth
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Option 4: GitLab OAuth
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
# GITLAB_HOST=https://gitlab.com

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Image tag (default: v0.1.44)
IMAGE_TAG=v0.1.44

# Postgres password (default: remote)
POSTGRES_PASSWORD=remote

# Electric role password (default: remote)
ELECTRIC_ROLE_PASSWORD=remote

# Server port (default: 8081)
SERVER_PORT=8081

# Postgres external port (default: 5433, for debugging)
POSTGRES_PORT=5433

# Log level
RUST_LOG=info,remote=info

# ===========================================
# OPTIONAL: Email Notifications (Loops)
# ===========================================
# LOOPS_EMAIL_API_KEY=
# LOOPS_INVITE_TEMPLATE_ID=
# LOOPS_REVIEW_READY_TEMPLATE_ID=
# LOOPS_REVIEW_FAILED_TEMPLATE_ID=
# DIGEST_ENABLED=false

# ===========================================
# OPTIONAL: GitHub App Integration
# ===========================================
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# ===========================================
# OPTIONAL: Artifact Storage (R2)
# ===========================================
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REVIEW_ENDPOINT=
# R2_REVIEW_BUCKET=
# REVIEW_WORKER_BASE_URL=

# ===========================================
# OPTIONAL: Azure Blob Storage
# ===========================================
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONTAINER_NAME=
# AZURE_STORAGE_ENDPOINT_URL=
# AZURE_STORAGE_PUBLIC_ENDPOINT_URL=